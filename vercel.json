{
  "version": 2,
  "buildCommand": "npx prisma generate && npx nest build",
  "builds": [
    {
      "src": "dist/api/index.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": ["dist/**", "prisma/**", "node_modules/.prisma/**"]
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "dist/api/index.js"
    }
  ],
  "crons": [
    {
      "path": "/sweep/cron",
      "schedule": "0 0 * * *"
    }
  ]
}
